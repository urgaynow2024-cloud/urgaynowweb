// Prisma schema configured for Supabase (PostgreSQL).
// - Runtime: DATABASE_URL -> Supabase Transaction Pooler (port 6543)
// - Migrations: DIRECT_URL -> Supabase direct connection (port 5432)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Staff {
  id             String   @id @default(cuid())
  name           String
  vrchatUsername String   @unique
  rank           String   @default("Member")
  bio            String   @default("")
  photoUrl       String   @default("")
  socials        String   @default("[]") // JSON array of { label, url }
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  hostedEvents   Event[]  @relation("EventHost")
  authoredAnnouncements Announcement[] @relation("AnnouncementAuthor")
  reviewedSubmissions CommunitySubmission[] @relation("CommunitySubmissionReviewer")
  moderationLogs CommunitySubmissionModerationLog[] @relation("ModerationLogStaff")
  assignedReports Report[] @relation("ReportAssignee")
  resolvedReports Report[] @relation("ReportResolver")
  reportAuditLogs ReportAuditLog[] @relation("ReportAuditActor")

  @@index([rank])
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String   @default("")
  description String   @default("")
  links       String   @default("[]") // JSON array of { label, url }
  tag         String   @default("Partner") // Partner | Affiliate | Friend Community
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String   @default("")
  content         String   @default("") // Markdown
  coverImage      String   @default("")
  state           String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  publishedAt     DateTime?
  scheduledAt     DateTime?
  authorId        String?
  author          Staff?   @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  categoryId      String?
  category        AnnouncementCategory? @relation(fields: [categoryId], references: [id])
  pinned          Boolean  @default(false)
  discordMessageId String?  @unique
  discordPosted   Boolean  @default(false)
  discordPostedAt DateTime?
  discordPostStatus String  @default("pending") // pending | sent | failed
  discordRoleIds  String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tags            AnnouncementTag[] @relation("AnnouncementTags")
}

model AnnouncementCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  color       String   @default("brand")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  announcements Announcement[]
}

model AnnouncementTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  color       String   @default("ink")
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  announcements Announcement[] @relation("AnnouncementTags")
}

enum PollType {
  SINGLE
  MULTIPLE
}

enum PollResultsVisibility {
  LIVE
  AFTER_CLOSE
  HIDDEN
}

model Poll {
  id                   String                @id @default(cuid())
  title                String
  slug                 String               @unique
  description          String               @default("")
  type                 PollType             @default(SINGLE)
  allowAnonymous       Boolean              @default(false)
  startAt              DateTime?
  endAt                DateTime?
  voteLimit            Int                  @default(0) // 0 = unlimited
  resultsVisibility    PollResultsVisibility @default(AFTER_CLOSE)
  closed               Boolean              @default(false)
  published            Boolean              @default(true)
  publishedAt          DateTime?
  // Discord webhook delivery (see 19-Notifications)
  discordPosted        Boolean              @default(false)
  discordPostedAt      DateTime?
  discordPostStatus    String               @default("pending") // pending | sent | failed
  discordRoleIds       String[]             @default([])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  options              PollOption[]
  votes                PollVote[]

  @@index([published, createdAt])
  @@index([slug])
}

model PollOption {
  id        String    @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int       @default(0)
  poll      Poll      @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id         String   @id @default(cuid())
  pollId     String
  optionId   String
  userId     String?
  anonId     String?
  createdAt  DateTime @default(now())
  poll       Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option     PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@unique([pollId, anonId])
  @@index([pollId, createdAt])
}

model Event {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  summary       String    @default("")
  description   String    @default("") // Markdown
  coverImage    String    @default("")
  startDateTime DateTime
  endDateTime   DateTime?
  timezone      String    @default("UTC")
  hostId        String?
  host          Staff?    @relation("EventHost", fields: [hostId], references: [id])
  hostName      String    @default("")
  location      String    @default("")
  vrchatWorldUrl String   @default("")
  category      String    @default("Other")
  tags          String[]  @default([])
  rules         String    @default("") // Markdown
status        String   @default("UPCOMING")
  published     Boolean  @default(true)
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reminders     EventReminder[]
  discordPosted   Boolean  @default(false)
  discordPostedAt DateTime?
  discordPostStatus String  @default("pending") // pending | sent | failed
  discordRoleIds  String[] @default([])
}

model Rule {
  id        String @id @default(cuid())
  category  String @default("General")
  title     String
  content   String @default("") // Markdown
  sortOrder Int    @default(0)
}

enum GuideCategory {
  GETTING_STARTED
  VRCHAT
  EVENTS
  COMMUNITY
  REPORTS
  ACCOUNTS
  SAFETY
  WEBSITE
  ACCESSIBILITY
  GENERAL
  SUPPORT
  STAFF
  DISCORD_SERVER
}

model Guide {
  id              String        @id @default(cuid())
  category        GuideCategory @default(GENERAL)
  question        String
  answer          String        @default("") // Markdown
  sortOrder       Int           @default(0)
  slug            String        @unique
  relatedGuides   Guide[]       @relation("GuideRelations")
  relatedTo       Guide?        @relation("GuideRelations", fields: [relatedToId], references: [id])
  relatedToId     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([category])
  @@index([slug])
}

model Link {
  id          String  @id @default(cuid())
  label       String
  url         String
  icon        String  @default("link") // emoji, icon identifier (discord/vrchat), or short text
  description String  @default("")
  category    String  @default("Other") // Community | VRChat | Socials | Support | Creators/Partners | Other
  featured    Boolean @default(false)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  @@index([category])
  @@index([featured])
  @@index([active])
}

enum UpdateType {
  MAJOR
  MINOR
  PATCH
}

model GalleryImage {
  id              String    @id @default(cuid())
  title           String
  description     String    @default("")
  imageUrl        String
  status          String    @default("APPROVED") // PENDING | APPROVED | REJECTED
  submitterName   String    @default("")
  rejectionReason String    @default("")
  reviewedAt      DateTime?
  slug            String    @unique
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, createdAt])
  @@index([slug])
}
 
enum ReleaseStatus {
  DRAFT
  PUBLISHED
  FAILED
}

model Update {
  id                    String       @id @default(cuid())
  slug                  String       @unique
  version               String
  type                  UpdateType
  title                 String
  summary               String       @default("")
  whatsNew              String       @default("")
  improvements          String       @default("")
  bugFixes              String       @default("")
  securityNotes         String       @default("")
  images                String       @default("[]") // JSON array
  authorId              String
  publishedAt           DateTime?
  discordPostedAt       DateTime?
  discordPostStatus     String       @default("pending") // pending, sent, failed
  sourceCommit          String?      @unique
  sourcePreviousCommit  String?
  sourceBranch          String?
  deploymentId          String?
  generatedAutomatically Boolean     @default(false)
  releaseStatus         ReleaseStatus @default(DRAFT)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([publishedAt])
  @@index([version])
  @@index([slug])
  @@index([sourceCommit])
  @@index([releaseStatus])
}

enum CommunitySubmissionType {
  ARTWORK
  AVATAR
  SCREENSHOT
  PHOTOGRAPHY
  VRCHAT_WORLD
  CREATOR_PROJECT
  OTHER
}

enum CommunitySubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  REQUEST_CHANGES
}

enum ReportStatus {
  RECEIVED
  UNDER_REVIEW
  ACTION_TAKEN
  RESOLVED
  DISMISSED
}

model CommunitySubmission {
  id                  String                   @id @default(cuid())
  type                CommunitySubmissionType
  status              CommunitySubmissionStatus @default(PENDING)
  title               String
  description         String                   @default("")
  imageUrl            String
  submitterName       String                   @default("")
  submitterEmail      String?                  @default("")
  fileName            String
  fileSize            Int
  contentType         String
  rejectionReason     String                   @default("")
  changeRequestNote   String                   @default("")
  reviewedAt          DateTime?
  reviewedBy          String?
  published           Boolean                  @default(false)
  publishedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  reports             CommunitySubmissionReport[]
  moderationLogs      CommunitySubmissionModerationLog[]
  reviewedByStaff     Staff?                   @relation("CommunitySubmissionReviewer", fields: [reviewedBy], references: [id])

  @@index([status, createdAt])
  @@index([type])
  @@index([published])
}

model CommunitySubmissionReport {
  id                String    @id @default(cuid())
  submissionId      String
  reason            String
  details           String    @default("")
  reporterName      String    @default("")
  reporterEmail     String?    @default("")
  anonymous         Boolean   @default(false)
  reportToken       String    @unique @default(cuid())
  status            ReportStatus @default(RECEIVED)
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  submission        CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([status, createdAt])
}

model CommunitySubmissionModerationLog {
  id                String    @id @default(cuid())
  submissionId      String
  action            String // APPROVED | REJECTED | REQUEST_CHANGES | UNPUBLISHED | REPORT_RESOLVED
  note              String    @default("")
  performedBy       String?
  performedAt       DateTime @default(now())
  submission        CommunitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  staff             Staff?   @relation("ModerationLogStaff", fields: [performedBy], references: [id])

  @@index([submissionId])
  @@index([performedAt])
}

model Report {
  id              String    @id @default(cuid())
  reportToken     String    @unique @default(cuid())
  contentType     String    // COMMUNITY_PHOTO | GALLERY_IMAGE | GROUP_PHOTO | EVENT | STAFF_PROFILE | SHOP_DESIGN | COMMUNITY_SUBMISSION | ANNOUNCEMENT
  contentId         String
  reporterId      String?   // authenticated session sub, if available
  reporterName    String    @default("")
  reporterEmail   String?   @default("")
  anonymous       Boolean   @default(false)
  reportedUserId  String?
  reportedUsername String?
  reason          String    // HARASSMENT | HATE_SPEECH | SEXUAL_CONTENT | NSFW | VIOLENCE | SCAM | SPAM | COPYRIGHT | IMPERSONATION | PERSONAL_INFO | RULE_VIOLATION | OTHER
  description     String
  evidence        String    @default("[]") // JSON array of { url, label? }
  status          String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | DISMISSED | ESCALATED
  priority        String    @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedToId    String?
  assignedTo      Staff?    @relation("ReportAssignee", fields: [assignedToId], references: [id])
  resolvedById    String?
  resolvedBy      Staff?    @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolution      String    @default("")
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  auditLogs       ReportAuditLog[]

  @@index([contentType, contentId])
  @@index([status, createdAt])
  @@index([status, priority, createdAt])
  @@index([assignedToId])
  @@index([reportToken])
}

model ReportAuditLog {
  id            String   @id @default(cuid())
  reportId      String
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  action        String   // SUBMITTED | ASSIGNED | STATUS_CHANGED | PRIORITY_CHANGED | NOTE_ADDED | RESOLVED | DISMISSED | ESCALATED | CONTENT_RESTORED
  actorId       String?
  actor         Staff?   @relation("ReportAuditActor", fields: [actorId], references: [id])
  actorName     String   @default("")
  detail        String   @default("")
  createdAt     DateTime @default(now())

  @@index([reportId, createdAt])
  @@index([actorId])
}

model GroupPhoto {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  imageUrl    String
  bannerUrl   String   @default("")
  rules       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

enum ThemeMode {
  MANUAL
  AUTOMATIC
}

model SiteTheme {
  id             String     @id @default(cuid())
  mode           ThemeMode  @default(MANUAL)
  manualThemeId  String?    // references theme registry ID
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  schedules      ThemeSchedule[]
}

model ThemeSchedule {
  id        String   @id @default(cuid())
  themeId   String
  start     DateTime
  end       DateTime
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  siteThemeId String
  siteTheme SiteTheme @relation(fields: [siteThemeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([themeId])
  @@index([start, end])
}

model ShopDesign {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  creator     String   @default("")
  category    String   @default("")
  imageUrl    String
  imageAlt    String   @default("")
  galleryUrls String[] @default([])
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  vrchatUsername String?  @unique
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reminders      EventReminder[]
}

model EventReminder {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId, remindAt])
  @@index([remindAt, sentAt])
  @@index([userId])
  @@index([eventId])
}

model HealthCheck {
  id        String   @id @default(cuid())
  serviceId String
  status    String
  latencyMs Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([serviceId, checkedAt])
}

model SupportRequest {
  id                String   @id @default(cuid())
  ticketNumber      String   @unique
  category          String
  subject           String
  description       String
  contactMethod     String
  contactInfo       String
  attachments       String   @default("[]")
  status            String   @default("OPEN")
  priority          String   @default("NORMAL")
  assignedStaffId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
  @@index([ticketNumber])
}

model ErrorLog {
  id         String    @id @default(cuid())
  message    String
  digest     String?
  path       String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([digest])
}
